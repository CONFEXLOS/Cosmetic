# ============================================
# BeautyLink Africa - Configuration Environment
# ============================================
# COPIER CE FICHIER EN .env LOCALEMENT (NE JAMAIS COMMITTER)

# Supabase Configuration
VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Authentication
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
VITE_FACEBOOK_CLIENT_ID=your-facebook-client-id-here

# WhatsApp Business (si configuré)
VITE_WHATSAPP_PHONE_NUMBER=your-whatsapp-business-number
VITE_WHATSAPP_API_TOKEN=your-whatsapp-api-token

# Payment Providers - SANDBOX MODE
VITE_WAVE_MERCHANT_ID=wave-sandbox-merchant-id
VITE_OMoney_MERCHANT_ID=omoney-sandbox-merchant-id
VITE_PAYMENT_PROVIDER=stripe-test-mode

# Analytics (optionnel)
VITE_GA_MEASUREMENT_ID=your-ga-measurement-id

# Email Service (optionnel - SMTP)
VITE_SMTP_HOST=smtp.gmail.com
VITE_SMTP_PORT=587
VITE_SMTP_USER=your-email@gmail.com
VITE_SMTP_PASS=your-app-specific-password

# Notes importantes :
# - NE JAMAIS COMMITTER ce fichier .env !
# - Remplir uniquement avec vos vraies clés de production
# - En développement, utilisez le mode sandbox pour tous les paiements